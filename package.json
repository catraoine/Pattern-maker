{
  "name": "pattern-maker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "eval:photo": "vite-node scripts/eval-photo.ts",
    "eval:likeness": "vite-node scripts/eval-likeness.ts",
    "test:e2e": "playwright test -c e2e",
    "sweep:all-round": "ROUND_SWEEP=all-round-sweep playwright test -c e2e e2e/all-round-sweep.spec.ts --project=phone && python3 scripts/all-round-sheet.py all-round-sweep/phone all-round-sweep/sheet.png",
    "record:tour": "node scripts/record-tour-shots.mjs tour-shots && node scripts/edit-tour.mjs tour-shots public/tour/walkthrough.mp4 && node scripts/record-tour-shots.mjs --wide && node scripts/edit-tour.mjs --wide",
    "record:demos": "node scripts/record-demos.mjs public/demos",
    "lint": "eslint src netlify e2e",
    "dead-code": "knip",
    "test:full": "SWEEP=full vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@netlify/blobs": "11.1.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "2.118.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "knip": "^5.88.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^5.4.11",
    "vite-node": "^2.1.8",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
